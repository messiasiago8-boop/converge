# Porta do Servidor Web
PORT=3000

# Chave de API do Google Gemini (para Copiloto IA e automações)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Segredo para assinatura dos tokens JWT
JWT_SECRET=seu_jwt_secret_forte_e_seguro_aqui

# PostgreSQL externo (Neon). Deixe vazio para usar SQLite/JSON local.
# Use a URL com SSL fornecida pelo provedor. Não a coloque no Git.
DATABASE_URL=

# Origens permitidas para CORS (separadas por vírgula em produção)
# Exemplo: https://meudominio.com,https://app.meudominio.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
