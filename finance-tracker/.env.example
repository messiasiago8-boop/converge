# Porta do Servidor de Finanças
PORT=3001

# Segredo para assinatura de Tokens JWT
JWT_SECRET=seu_jwt_secret_forte_e_seguro_aqui

# Chave de API do Google Gemini (para consultor financeiro IA)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Origens permitidas para CORS (separadas por vírgula em produção)
# Exemplo: https://meudominio.com,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
